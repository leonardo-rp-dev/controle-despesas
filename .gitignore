# =====================================================
# Controle de Despesas - .gitignore
# =====================================================

# --- Build (Maven) ---
# Saída de compilação e artefatos gerados
target/
*.class
*.jar
*.war
*.ear
dependency-reduced-pom.xml
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties

# --- Maven Wrapper ---
# Mantém mvnw, mvnw.cmd e .mvn/wrapper/maven-wrapper.properties versionados
.mvn/wrapper/maven-wrapper.jar
!.mvn/wrapper/maven-wrapper.properties

# --- Logs ---
*.log
logs/
log/

# --- Banco de dados SQLite ---
# Arquivos de dados locais e auxiliares (journal, WAL, shared memory)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# --- Configuração local e segredos ---
.env
.env.*
!.env.example
application-local.properties
application-local.yml
application-local.yaml

# --- IntelliJ IDEA ---
.idea/
*.iml
*.iws
*.ipr
out/

# --- Eclipse / STS ---
.classpath
.project
.settings/
.apt_generated/
.factorypath
.springBeans
.sts4-cache/
bin/

# --- VS Code ---
.vscode/
*.code-workspace

# --- Sistema operacional ---
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.Trash-*

# --- Temporários ---
*.tmp
*.swp
*.swo
*.bak
